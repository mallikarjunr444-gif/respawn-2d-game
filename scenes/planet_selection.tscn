[gd_scene format=3 uid="uid://planet_selection"]

[ext_resource type="Script" path="res://scenes/planet_selection.gd" id="1_script"]

[node name="PlanetSelection" type="Control"]
script = ExtResource("1_script")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.015, 0.035, 0.065, 0.94)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(560, 540)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

# Title
[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 22
text = "UNKNOWN TRANSMISSIONS"
horizontal_alignment = 1

[node name="Prompt" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.82, 0.9, 0.9)
text = "Destination unknown. Choose your trajectory."
horizontal_alignment = 1

# Buttons for six worlds
[node name="W1Btn" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "[ O ]  UNKNOWN SIGNAL 01"

[node name="W2Btn" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "[ / ]  UNKNOWN SIGNAL 02"

[node name="W3Btn" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "[ # ]  UNKNOWN SIGNAL 03"

[node name="W4Btn" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "[ ~ ]  UNKNOWN SIGNAL 04"

[node name="W5Btn" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "[ + ]  UNKNOWN SIGNAL 05"

[node name="W6Btn" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "[ * ]  UNKNOWN SIGNAL 06"

[node name="Status" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.94, 1, 1)
text = ""
horizontal_alignment = 1

# Back button
[node name="BackBtn" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(120, 32)
text = "BACK TO MENU"

[node name="ScanLine" type="ColorRect" parent="."]
layout_mode = 1
anchor_right = 1.0
offset_bottom = 2.0
mouse_filter = 2
color = Color(0.3, 0.9, 1, 0.22)

[node name="WarpOverlay" type="ColorRect" parent="."]
visible = true
modulate = Color(1, 1, 1, 0)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.15, 0.85, 1, 1)

[connection signal="pressed" from="Center/Panel/VBox/BackBtn" to="." method="_on_back_pressed"]

