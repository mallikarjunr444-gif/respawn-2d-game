[node name="ControlsText" type="Label" parent="ControlsModal/VBox"]
layout_mode = 2
text = "• MOVE: [A] / [D] or Left / Right Arrows
• JUMP: [SPACE] or [W] (Hold for full height)
• DASH: [SHIFT] (Air & Ground invulnerable boost)
• SWORD SLASH: [J] or [Left Click] (Destroys voidlings & barriers)
• PLASMA BLASTER: [K] or [Right Click] (Ranged energy bolts)
• GRAVITY LANCE: [Hold K, release] (Piercing vortex shot)
• PHASE SHIELD: [Q] (Absorbs incoming projectiles)
• INTERACT: [E] (Forge terminals & devices)
• RETRY: [R] | PAUSE: [ESC]"
horizontal_alignment = 1

