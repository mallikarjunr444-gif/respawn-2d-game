[node name="ControlsText" type="Label" parent="ControlsModal/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "LAUNCH EXPEDITION — Story route across six unknown worlds.
INFINITE FRONTIER — Endless survival with a full weapon loadout.
ROCKET HANGAR — Review unlocked weapons, crystals, and records.

MOVE: [A] / [D] or Left / Right Arrows
JUMP / THRUSTER: [W] or [SPACE]
DASH / BOOST: [SHIFT]
SWORD SLASH: [J] or Left Click
PLASMA BLASTER: [K] or Right Click  (hold to charge the Gravity Lance)
PHASE SHIELD: [Q]
INTERACT / BOARD: [E]
PAUSE: [ESC]   RETRY: [R]   SOUND: [M]

Forge terminals unlock weapons. Reach the escape rocket before the Devourer closes in."
horizontal_alignment = 1
autowrap_mode = 3

[node name="CloseControlsBtn" type="Button" parent="ControlsModal/VBox"]
custom_minimum_size = Vector2(160, 36)
layout_mode = 2
size_flags_horizontal = 4
text = "BACK TO BRIDGE"

