[node name="Content" type="RichTextLabel" parent="ControlsModal/VBox"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[color=#5cd6ff]FLIGHT CONTROLS[/color]
• [b]W / A / S / D[/b] or [b]Arrow Keys[/b] — Steer Astronaut Flight Angle
• [b]SPACEBAR[/b] — Fire Main Thruster (Consumes Fuel)
• [b]SHIFT[/b] — Emergency Rocket Boost (High Speed Burst)

[color=#5cd6ff]MISSION OBJECTIVES[/color]
• Collect [b]Fuel Cells[/b] & [b]Energy Orbs[/b] to replenish your tank.
• Dodge planetary hazards (storms, wind currents, debris, heat zones).
• Reach the [b]Launch Gate[/b] with enough fuel to warp to the next world!
• Singularity gravity exists [b]only in Level 1 (Black Space)[/b].

[color=#5cd6ff]COMBAT & RECOVERY[/color]
• [b]J / LMB[/b] — Energy Sword | [b]K / RMB[/b] — Blaster
• [b]Q[/b] — Phase Shield | [b]Hold K[/b] — Gravity Lance
• Hull damage drains fuel as an emergency stabilization penalty."

