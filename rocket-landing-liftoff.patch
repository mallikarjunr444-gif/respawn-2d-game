+function cycleVolume(){
+  const vols = [100, 75, 50, 25, 0];
+  let idx = vols.indexOf(SETTINGS.volume);
+  if(idx === -1) idx = 0;
+  SETTINGS.volume = vols[(idx + 1) % vols.length];
+  if(SETTINGS.volume > 0 && SETTINGS.muted) SETTINGS.muted = false;
+  saveSettings();
+  SFX.click();
+  settingsFeedback = 'SFX Volume set to ' + SETTINGS.volume + '%';
+  settingsFeedbackT = 3.5;
